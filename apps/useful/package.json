{
  "name": "@useful/app",
  "private": true,
  "version": "0.1.0-beta.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build --manifest && node ../../scripts/frontend-size-report.mjs && node ../../scripts/size-budget.mjs --profile frontend --json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run --config vitest.bench.config.ts && vitest run --config vitest.bench.config.ts bench/procTable.perf.spec.ts",
    "lint": "eslint . --ext .ts,.vue --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@useful/agent-profile": "workspace:^",
    "@useful/action-runtime": "workspace:^",
    "@useful/office-core": "workspace:^",
    "@useful/sdk": "workspace:*",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "fast-check": "^4.9.0",
    "jsdom": "^25.0.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.6",
    "vue-tsc": "^2.2.0"
  },
  "license": "MPL-2.0"
}
