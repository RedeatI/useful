{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Useful",
  "mainBinaryName": "Useful",
  "version": "0.1.0-beta.5",
  "identifier": "io.github.redeati.useful",
  "build": {
    "beforeDevCommand": "pnpm --filter @useful/app dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @useful/app build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Useful",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'self' usefulplugin: http://usefulplugin.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": []
  }
}
