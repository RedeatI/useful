{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Useful 主窗口默认能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:default",
    "dialog:default",
    "opener:default"
  ]
}
