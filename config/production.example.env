# config/production.example.env —— 生产环境配置示例
# 所有 change-me-* 与占位值必须替换为真实值（多数由 Owner Gate 提供，见 docs/OWNER-GATES.md）。
# 生产启动会强制以下不变量，占位/不安全值将 fail closed 拒绝启动。

ENVIRONMENT=production
HTTP_ADDR=:8080

# 必填：Postgres DSN（生产必须使用 Postgres，缺失拒绝启动）
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/useful_source?sslmode=require

SOURCE_ID=com.your-org.source
SOURCE_NAME=Your Source
SOURCE_OPERATOR=Your Org
# 必须 https://（非 HTTPS 拒绝启动）—— Owner Gate OG-3
BASE_URL=https://source.example.com

# 生产对象存储 —— Owner Gate OG-4（S3_BUCKET 必填）
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=useful-artifacts-prod
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME

# 生产禁止 fake；启用支付需真实 provider —— Owner Gate OG-6
BILLING_PROVIDER=disabled

# 必填：下载令牌 HMAC 秘钥（缺失拒绝启动）
DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_RANDOM_32_BYTES

# 启用计费的生产必须提供 —— Owner Gate OG-5
OAUTH_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_BYTES

# Sigstore 信任根（由 TUF 分发预置）—— Owner Gate OG-1 相关
SIGSTORE_TRUST_DIR=/etc/useful/sigstore

# 生产禁止（AUTO_APPROVE=true 拒绝启动）——必须人工审核
AUTO_APPROVE=false

# 生产禁止静态 ADMIN_TOKEN（拒绝启动）：改用 `source-server -init-admin` 签发 API Token。
# 紧急恢复例外（默认关闭）：EMERGENCY_ADMIN_MODE=true + EMERGENCY_ADMIN_UNTIL（≤24h, RFC3339）
# ADMIN_TOKEN=
