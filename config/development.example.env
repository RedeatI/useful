# config/development.example.env —— 开发环境配置示例（复制为 .env 使用）
# 全部为本地开发默认；绝不含生产密钥。

ENVIRONMENT=development
HTTP_ADDR=:8080

# 留空使用内存仓库（仅开发/测试）；填 postgres DSN 走 Postgres
DATABASE_URL=

SOURCE_ID=com.example.dev-source
SOURCE_NAME=Dev Source
SOURCE_OPERATOR=Self-hosted
BASE_URL=http://127.0.0.1:8080

STORAGE_DRIVER=filesystem
STORAGE_PATH=./data/storage
TUF_KEYS_DIR=./data/tuf-keys

BILLING_PROVIDER=disabled

# 开发 bootstrap 令牌（换取首个 API Token 后走 Bearer）
ADMIN_TOKEN=dev-admin-token
DOWNLOAD_TOKEN_SECRET=dev-download-secret
OAUTH_SIGNING_SECRET=dev-oauth-secret

# 开发便利：自动审核发布（生产禁止）
AUTO_APPROVE=true

# 限额（默认值即可）
MAX_UPLOAD_SIZE=268435456
MAX_REQUEST_BODY=1048576
DOWNLOAD_GRANT_TTL_SECONDS=600
