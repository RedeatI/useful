# 复制为 .env 后按需修改。不要提交真实凭据。
# 生产密钥只通过环境变量或秘密管理器提供。

# development | production（production 会强制 HTTPS BaseURL、拒绝 fake 支付与 AUTO_APPROVE）
ENVIRONMENT=development

POSTGRES_PASSWORD=useful-dev-password
HTTP_PORT=8080

SOURCE_ID=com.example.self-hosted
SOURCE_NAME=Self-hosted Source
SOURCE_OPERATOR=Self-hosted
# 客户端可访问的对外地址；生产必须 https://
BASE_URL=http://127.0.0.1:8080

# disabled | fake（fake 仅测试/演示；生产启用会被启动检测直接拒绝）
BILLING_PROVIDER=disabled

# 开发 bootstrap 令牌（仅 development）：用于换取首个 API Token 后即走 Bearer。
# 生产环境设置静态 ADMIN_TOKEN 会被拒绝启动，除非显式紧急恢复模式（见下）。
ADMIN_TOKEN=change-me-admin-token
DOWNLOAD_TOKEN_SECRET=change-me-download-secret
# OAuth 令牌签名秘钥（启用计费时必需；未设则开发环境随机生成）
OAUTH_SIGNING_SECRET=change-me-oauth-secret

# 紧急恢复模式（默认关闭）：生产临时启用 X-Admin-Token，需同时给短期有效期（≤24h, RFC3339）。
# EMERGENCY_ADMIN_MODE=false
# EMERGENCY_ADMIN_UNTIL=2026-01-01T00:00:00Z

# Sigstore 信任根目录（fulcio-root.pem + rekor.pub）；为空时 Sigstore 验证 fail closed。
# SIGSTORE_TRUST_DIR=

# 开发便利：扫描通过后自动审核发布（生产禁止）
AUTO_APPROVE=true
