{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.useful.local/host/useful.host-actions.v1.schema.json",
  "title": "Useful Host Actions v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enabled", "readRoots", "writeRoots", "process"],
  "properties": {
    "schemaVersion": { "const": "useful.host-actions.v1" },
    "ffmpegPath": { "type": "string", "minLength": 1, "maxLength": 32768 },
    "ffprobePath": { "type": "string", "minLength": 1, "maxLength": 32768 },
    "readRoots": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 32768 }
    },
    "writeRoots": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 32768 }
    },
    "enabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videoProbe", "videoExport", "processSnapshot", "processTerminate"],
      "properties": {
        "videoProbe": { "type": "boolean" },
        "videoExport": { "type": "boolean" },
        "processSnapshot": { "type": "boolean" },
        "processTerminate": { "type": "boolean" }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowOverwrite", "maxDurationSec", "maxProbeOutputBytes", "videoCodecs", "audioCodecs"],
      "properties": {
        "allowOverwrite": { "const": false },
        "maxDurationSec": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "maxProbeOutputBytes": { "type": "integer", "minimum": 4096, "maximum": 16777216 },
        "videoCodecs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["copy", "libx264", "libx265", "libvpx-vp9"] }
        },
        "audioCodecs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["copy", "aac", "libopus"] }
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "maxProcesses", "maxOutputBytes"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["pid", "startTime", "name"] },
          "allOf": [
            { "contains": { "const": "pid" } },
            { "contains": { "const": "startTime" } }
          ]
        },
        "maxProcesses": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxOutputBytes": { "type": "integer", "minimum": 4096, "maximum": 16777216 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["enabled"],
        "properties": {
          "enabled": {
            "type": "object",
            "required": ["videoProbe"],
            "properties": { "videoProbe": { "const": true } }
          }
        }
      },
      "then": {
        "required": ["video", "ffprobePath"],
        "properties": {
          "video": {},
          "ffprobePath": {},
          "readRoots": { "type": "array", "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "required": ["enabled"],
        "properties": {
          "enabled": {
            "type": "object",
            "required": ["videoExport"],
            "properties": { "videoExport": { "const": true } }
          }
        }
      },
      "then": {
        "required": ["video", "ffmpegPath"],
        "properties": {
          "video": {},
          "ffmpegPath": {},
          "readRoots": { "type": "array", "minItems": 1 },
          "writeRoots": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
