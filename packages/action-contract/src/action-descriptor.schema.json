{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.useful.local/actions/v1/action-descriptor.schema.json",
  "title": "Useful ActionDescriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "actionId",
    "version",
    "source",
    "title",
    "description",
    "keywords",
    "aliases",
    "inputSchema",
    "outputSchema",
    "examples",
    "testVectors",
    "execution",
    "behavior",
    "permissions",
    "sensitive"
  ],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "actionId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$",
      "not": { "enum": ["useful.actions.search", "useful.actions.describe", "useful.actions.suggest", "useful.actions.recipe"] }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "toolId", "publisher", "digest"],
      "properties": {
        "kind": { "enum": ["builtin", "plugin", "local"] },
        "toolId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "keywords": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "aliases": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "not": { "enum": ["useful.actions.search", "useful.actions.describe", "useful.actions.suggest", "useful.actions.recipe"] }
      }
    },
    "inputSchema": { "$ref": "#/$defs/valueSchema" },
    "outputSchema": { "$ref": "#/$defs/valueSchema" },
    "examples": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input", "output"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "input": {},
          "output": {}
        }
      }
    },
    "testVectors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "input": {},
          "expectedOutput": {},
          "expectedErrorCode": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "oneOf": [
          {
            "properties": { "expectedOutput": {} },
            "required": ["expectedOutput"]
          },
          {
            "properties": { "expectedErrorCode": {} },
            "required": ["expectedErrorCode"]
          }
        ]
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "timeoutMs",
        "maxInputBytes",
        "maxOutputBytes",
        "supportsCancellation"
      ],
      "properties": {
        "mode": { "enum": ["pure", "host", "worker", "ui-only"] },
        "handler": { "type": "string", "minLength": 1, "maxLength": 200 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "supportsCancellation": { "type": "boolean" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnly",
        "destructive",
        "idempotent",
        "openWorld",
        "sideEffects",
        "requiresConfirmation"
      ],
      "properties": {
        "readOnly": { "type": "boolean" },
        "destructive": { "type": "boolean" },
        "idempotent": { "type": "boolean" },
        "openWorld": { "type": "boolean" },
        "sideEffects": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "requiresConfirmation": { "type": "boolean" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "capabilities"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "capabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "sensitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "redactLogs"],
      "properties": {
        "input": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPointer" }
        },
        "output": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/jsonPointer" }
        },
        "redactLogs": { "const": true }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route": { "type": "string", "minLength": 1, "maxLength": 512 },
        "icon": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source": { "type": "object", "properties": { "kind": { "const": "builtin" } } } }
      },
      "then": {
        "properties": {
          "actionId": { "type": "string", "pattern": "^builtin\\." },
          "source": { "type": "object", "properties": { "toolId": { "type": "string", "pattern": "^builtin\\." } } }
        }
      }
    },
    {
      "if": {
        "properties": { "source": { "type": "object", "properties": { "kind": { "enum": ["plugin", "local"] } } } }
      },
      "then": {
        "properties": {
          "actionId": { "type": "string", "not": { "pattern": "^builtin\\." } },
          "source": { "type": "object", "properties": { "toolId": { "type": "string", "not": { "pattern": "^builtin(?:\\.|$)" } } } },
          "aliases": { "type": "array", "items": { "type": "string", "not": { "pattern": "^builtin\\." } } }
        }
      }
    }
  ],
  "$defs": {
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
    },
    "valueSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
        "type": {
          "oneOf": [
            { "enum": ["object", "array", "string", "number", "integer", "boolean", "null"] },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["object", "array", "string", "number", "integer", "boolean", "null"] }
            }
          ]
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "properties": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/valueSchema" }
        },
        "required": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": { "const": false },
        "items": { "$ref": "#/$defs/valueSchema" },
        "enum": { "type": "array", "minItems": 1 },
        "const": {},
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "uniqueItems": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "object" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "properties": {},
              "additionalProperties": {}
            },
            "required": ["properties", "additionalProperties"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "array" } },
            "required": ["type"]
          },
          "then": {
            "properties": { "items": {} },
            "required": ["items"]
          }
        }
      ]
    }
  }
}
