{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.useful.local/actions/v2/execution-receipt.schema.json",
  "title": "Useful Execution Receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptVersion", "actionId", "actionVersion", "contractVersion", "source", "permissions", "status", "createdAt"],
  "properties": {
    "receiptVersion": { "const": "2.0" },
    "actionId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9][a-z0-9_-]*)+$", "maxLength": 200 },
    "actionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$", "maxLength": 128 },
    "contractVersion": { "type": "string", "minLength": 1, "maxLength": 32 },
    "source": { "$ref": "#/$defs/source" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "status": { "enum": ["queued", "running", "success", "error", "cancelled"] },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "completedAt": { "$ref": "#/$defs/timestamp" },
    "durationMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "error": { "$ref": "#/$defs/error" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "queued" } }, "required": ["status"] },
      "then": { "not": { "anyOf": [
        { "properties": { "startedAt": true }, "required": ["startedAt"] },
        { "properties": { "completedAt": true }, "required": ["completedAt"] },
        { "properties": { "durationMs": true }, "required": ["durationMs"] },
        { "properties": { "error": true }, "required": ["error"] }
      ] } }
    },
    {
      "if": { "properties": { "status": { "const": "running" } }, "required": ["status"] },
      "then": {
        "properties": { "startedAt": true },
        "required": ["startedAt"],
        "not": { "anyOf": [
          { "properties": { "completedAt": true }, "required": ["completedAt"] },
          { "properties": { "durationMs": true }, "required": ["durationMs"] },
          { "properties": { "error": true }, "required": ["error"] }
        ] }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["success", "error", "cancelled"] } }, "required": ["status"] },
      "then": { "properties": { "startedAt": true, "completedAt": true, "durationMs": true }, "required": ["startedAt", "completedAt", "durationMs"] }
    },
    {
      "if": { "properties": { "status": { "const": "success" } }, "required": ["status"] },
      "then": { "not": { "properties": { "error": true }, "required": ["error"] } }
    },
    {
      "if": { "properties": { "status": { "enum": ["error", "cancelled"] } }, "required": ["status"] },
      "then": { "properties": { "error": true }, "required": ["error"] }
    },
    {
      "if": { "properties": { "status": { "const": "cancelled" } }, "required": ["status"] },
      "then": { "properties": { "error": { "type": "object", "properties": { "code": { "const": "CANCELLED" } } } } }
    }
  ],
  "$defs": {
    "safeString": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "^(?:/|\\\\\\\\|[A-Za-z]:[\\\\/])" } },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "toolId", "publisher", "digest"],
      "properties": {
        "kind": { "enum": ["builtin", "plugin", "local"] },
        "toolId": { "$ref": "#/$defs/safeString" },
        "publisher": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": { "id": { "$ref": "#/$defs/safeString" }, "name": { "$ref": "#/$defs/safeString" } }
        },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "stringSet": { "type": "array", "uniqueItems": true, "maxItems": 128, "items": { "$ref": "#/$defs/safeString" } },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "capabilities"],
      "properties": { "required": { "$ref": "#/$defs/stringSet" }, "capabilities": { "$ref": "#/$defs/stringSet" } }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" } }
    }
  }
}
