{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.useful.local/plugin-actions/useful.plugin-action.v1.schema.json",
  "title": "Useful declarative plugin action v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "description", "keywords", "aliases", "inputSchema", "outputSchema", "examples", "testVectors", "execution", "pipeline"],
  "properties": {
    "schemaVersion": { "const": "useful.plugin-action.v1" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "keywords": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "aliases": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "not": { "enum": ["useful.actions.search", "useful.actions.describe", "useful.actions.suggest", "useful.actions.recipe"] }
      }
    },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "examples": { "type": "array", "maxItems": 32 },
    "testVectors": { "type": "array", "minItems": 1, "maxItems": 64 },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutMs", "maxInputBytes", "maxOutputBytes"],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "presentation": { "type": "object" },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps", "output"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "actionId", "input"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
              "actionId": { "enum": ["builtin.utilities.json", "builtin.utilities.base64", "builtin.utilities.hash"] },
              "input": {}
            }
          }
        },
        "output": {}
      }
    }
  }
}
