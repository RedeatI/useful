{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.useful.example/trp/v1/publisher.schema.json",
  "title": "TRP v1 Publisher",
  "description": "发布者身份与公钥集合。密钥轮换要求新旧交叉签名或由现有受信密钥授权；无法证明连续性时视为新发布者，不静默继承信誉。",
  "type": "object",
  "additionalProperties": false,
  "required": ["publisherId", "displayName", "keys"],
  "properties": {
    "publisherId": { "$ref": "common.schema.json#/$defs/lowercaseId" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "homepage": { "$ref": "common.schema.json#/$defs/httpsUrl" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "publicKey", "status", "createdAt"],
        "properties": {
          "keyId": { "$ref": "common.schema.json#/$defs/publisherKeyId" },
          "algorithm": { "type": "string", "enum": ["ed25519", "sigstore"] },
          "publicKey": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "status": { "type": "string", "enum": ["active", "rotated", "revoked"] },
          "createdAt": { "$ref": "common.schema.json#/$defs/rfc3339" },
          "rotatedTo": { "$ref": "common.schema.json#/$defs/publisherKeyId" },
          "crossSignature": {
            "type": "string",
            "description": "由被替换密钥对新密钥的交叉签名（base64），用于证明连续性。",
            "maxLength": 4096
          }
        }
      }
    }
  }
}
