{
  "name": "@useful/protocol",
  "version": "1.0.0",
  "description": "Useful 联邦软件源协议 TRP v1（兼容历史名称 Useful Repository Protocol）规范：公开 JSON Schema、OpenAPI 与测试向量。Apache-2.0。",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "schemas",
    "openapi",
    "test-vectors",
    "src"
  ],
  "exports": {
    "./agent-connection": {
      "types": "./src/agent-connection.d.ts",
      "import": "./src/agent-connection.mjs"
    },
    "./agent-integration": {
      "types": "./src/agent-integration.d.ts",
      "import": "./src/agent-integration.mjs"
    },
    "./agent-probe": {
      "types": "./src/agent-probe.d.ts",
      "import": "./src/agent-probe.mjs"
    },
    "./schemas/*": "./schemas/*",
    "./openapi/*": "./openapi/*",
    "./src/*": "./src/*"
  },
  "typesVersions": {
    "*": {
      "agent-connection": ["src/agent-connection.d.ts"],
      "agent-integration": ["src/agent-integration.d.ts"],
      "agent-probe": ["src/agent-probe.d.ts"]
    }
  },
  "scripts": {
    "test": "node --test",
    "validate": "node src/validate-cli.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "yaml": "^2.6.1"
  }
}
