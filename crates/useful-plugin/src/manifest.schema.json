{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Useful Plugin Manifest",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "entry"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*(\\.[a-zA-Z][a-zA-Z0-9_-]*)+$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "maxLength": 1024 },
    "icon": { "type": "string", "maxLength": 512 },
    "entry": {
      "type": "object",
      "required": ["type", "path"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["web", "launcher", "worker"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sidebar": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "group": { "type": "string", "enum": ["installed", "builtin"] },
              "order": { "type": "integer" }
            }
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["actionId", "path"],
            "additionalProperties": false,
            "properties": {
              "actionId": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200,
                "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*)+$"
              },
              "path": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 }
    },
    "platforms": {
      "type": "array",
      "items": { "type": "string", "enum": ["windows-x64", "windows-arm64"] }
    },
    "minHostVersion": { "type": "string", "minLength": 1 }
  }
}
